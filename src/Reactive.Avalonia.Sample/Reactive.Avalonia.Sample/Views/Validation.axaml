<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Reactive.Avalonia.Sample.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Reactive.Avalonia.Sample.Views.Validation"
             x:DataType="vm:ValidationViewModel">

    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- INotifyDataErrorInfo: the rules in the view model surface here with no extra XAML. -->
        <TextBox MinWidth="200" Text="{Binding Name}" PlaceholderText="Your name" />

        <!-- ReactiveCommand: disabled while validation fails. -->
        <Button
            Content="Greet"
            IsDefault="True"
            Command="{Binding Greet}" HorizontalAlignment="Center" />

        <TextBlock Text="{Binding LastGreeting}" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>