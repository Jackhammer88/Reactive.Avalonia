<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Reactive.Avalonia.Sample.Views"
             xmlns:viewModels="clr-namespace:Reactive.Avalonia.Sample.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Reactive.Avalonia.Sample.Views.MainView"
             x:DataType="viewModels:MainViewModel">
    
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <Style Selector="TextBlock.active">
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <viewModels:MainViewModel />
    </Design.DataContext>
    
    <TabControl ItemsSource="{Binding TabVms}"
                SelectedItem="{Binding SelectedTab}">
        <TabControl.ItemTemplate>
            <DataTemplate x:DataType="viewModels:TabItemViewModelBase">
                <TextBlock Text="{Binding Title}"
                           Classes.active="{Binding IsActive}" />
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.DataTemplates>
            <DataTemplate DataType="viewModels:ValidationViewModel">
                <views:Validation />
            </DataTemplate>

            <DataTemplate DataType="viewModels:CommandViewModel">
                <views:Command />
            </DataTemplate>
            
            <DataTemplate DataType="viewModels:InteractionViewModel">
                <views:Interaction />
            </DataTemplate>
        </TabControl.DataTemplates>
    </TabControl>
</UserControl>
