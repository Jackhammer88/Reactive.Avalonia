<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Reactive.Avalonia.Sample.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Reactive.Avalonia.Sample.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Reactive.Avalonia.Sample.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="450" Height="350"
        Icon="/Assets/avalonia-logo.ico"
        Title="Reactive.Avalonia.Sample">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <Style Selector="TextBlock.active">
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    
    <TabControl ItemsSource="{Binding TabVms}"
                SelectedItem="{Binding SelectedTab}">
        <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TabItemViewModelBase">
                <TextBlock Text="{Binding Title}"
                           Classes.active="{Binding IsActive}" />
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.DataTemplates>
            <DataTemplate DataType="vm:ValidationViewModel">
                <views:Validation />
            </DataTemplate>

            <DataTemplate DataType="vm:CommandViewModel">
                <views:Command />
            </DataTemplate>
            
            <DataTemplate DataType="vm:InteractionViewModel">
                <views:Interaction />
            </DataTemplate>
        </TabControl.DataTemplates>
    </TabControl>

</Window>
